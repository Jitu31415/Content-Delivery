# Copy to .env and fill in. Loaded via python-dotenv at startup.

# Required for the admin endpoints (/admin/substack-cookie, /admin/run-worker).
# Without this set, both admin endpoints return 403 unconditionally.
ADMIN_TOKEN=mynameisjitu

# Substack session cookie value (the substack.sid cookie, value only —
# not the full Cookie header). Can be left blank and set later via
# POST /admin/substack-cookie once the server is running.
SUBSTACK_COOKIE=s%3AmAgWRySWvZ8DKfWOkjy29YLy7VDxP4Zb.2eGC3H1O8H2IXy3YIH2MPs3shgZwzkGt062NUiRDxnw

# Comma-separated. Check https://api.invidious.io/ for currently healthy
# public instances before deploying — the defaults baked into config.py
# will go stale over time.
INVIDIOUS_INSTANCES=https://vid.puffyan.us,https://invidious.privacyredirect.com,https://yewtu.be

WORKER_INTERVAL_HOURS=1
PRUNE_DAYS=30

# Optional. If unset, /youtube/search falls back automatically to the
# Invidious + heuristic-filter path (see README's "Educational search" section).
# If set: get a key at https://console.cloud.google.com/apis/credentials,
# enable the YouTube Data API v3 on that project, and restrict the key to
# that API. search.list costs 100 quota units/call against a 10,000/day
# default — SEARCH_CACHE_TTL_HOURS exists specifically to keep this usable.


YOUTUBE_API_KEY=AIzaSyD5r6gGol-V92F8ZXGyFDoGz2E9hIRgVH8

SEARCH_CACHE_TTL_HOURS=6


